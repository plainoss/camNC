index 0000000..32a3f4b
--- /dev/null
+++ b/apps/camNC/src/cad/assistant/checkHints.ts
@@ -0,0 +1,31 @@
+type Issue = { code?: unknown; message?: unknown; part?: unknown };
+const issues = (value: unknown): Issue[] => (Array.isArray(value) ? (value as Issue[]) : []);
+
+const hints: Record<string, (issue: Issue) => string> = {
+  'parts-collide': issue =>
+    `${String(issue.message ?? 'Two parts overlap.')} If one board should sit in the other, keep the overlap and join them with d.cutParts(receivingPart, { with: [boardThatSitsInIt] }) so the overlap becomes the housing; otherwise move or resize one so they only touch.`,
+  'cut-too-deep': issue =>
+    `${String(issue.part ?? 'A part')}: a pocket is as deep as the board. Make it shallower than the thickness or use depth 'through'. For a joint, overlap the boards and use d.cutParts rather than a hand-drawn pocket.`,
+  'cut-through-edge': issue =>
+    `${String(issue.part ?? 'A part')}: a through cut reaches the edge. Change that part's profile for an open notch, or overlap the boards and use d.cutParts for a joint.`,
+  'expect-failed': issue =>
+    `${String(issue.part ?? 'A part')}: ${String(issue.message ?? 'an expectation failed')}. Fix the geometry to match the request; change the expectation only if the request did.`,
+  'ambiguous-profile': issue => `${String(issue.part ?? 'A part')}: cut shapes in one sketch touch or branch. Keep each cut a separate closed shape that touches nothing else.`,
+  'intersecting-profiles': issue => `${String(issue.part ?? 'A part')}: cut shapes cross or touch. Space them apart, or merge them into one closed outline.`,
+  'disconnected-profile': issue => `${String(issue.part ?? 'A part')}: its outline has separate pieces. Make each piece its own part.`,
+};
+
+/** One short, issue-specific next step for a check result, so a failed check is repaired rather than reported as a proposal. */
+export function checkNextStep(checked: { ok: boolean; report: unknown; scriptError?: string }): string {
+  const report = (checked.report ?? {}) as { errors?: unknown; warnings?: unknown };
+  if (checked.scriptError)
+    return 'The script stopped and nothing was built. Fix the reported call and resend the whole script with check_design. Do not reply with Proposal: until a check passes.';
+  if (checked.ok) {
+    const warnings = [...new Set(issues(report.warnings).map(issue => String(issue.code)))];
+    return warnings.length
+      ? `Check passed with warnings (${warnings.join(', ')}). Fix any that matter for the request; if it then meets the request, reply starting with Proposal: and mention the remaining warnings.`
+      : 'Check passed. Compare the reported sizes, parts and joints with the request; if it meets it, reply starting with Proposal:. Otherwise fix the unmet requirement and check again.';
+  }
+  const steps = [...new Set(issues(report.errors).map(issue => hints[String(issue.code)]?.(issue) ?? `${String(issue.code)}: ${String(issue.message ?? '')}`))];
+  return `Not a valid candidate yet; do not reply with Proposal: until a check passes. Next: ${steps.slice(0, 4).join(' ')}${steps.length > 4 ? ` (+${steps.length - 4} more)` : ''}`;
+}
diff --git a/apps/camNC/src/cad/assistant/compactCheck.ts b/apps/camNC/src/cad/assistant/compactCheck.ts
new file mode 100644
index 0000000..f9defe9
--- /dev/null
+++ b/apps/camNC/src/cad/assistant/compactCheck.ts
@@ -0,0 +1,53 @@
+type Data = Record<string, unknown>;
+const record = (value: unknown): Data => (value && typeof value === 'object' && !Array.isArray(value) ? (value as Data) : {});
+const rows = (value: unknown): Data[] => (Array.isArray(value) ? value.map(record) : []);
+
+function brief(part: Data, body?: Data): Data {
+  return {
+    name: part.name,
+    ref: part.ref,
+    thickness: part.thickness,
+    outline: record(part.outline).size,
+    ...(part.holes ? { holes: part.holes } : {}),
+    ...(part.notches ? { notches: part.notches } : {}),
+    ...(rows(part.cuts).length && {
+      cuts: rows(part.cuts).map(cut => ({ ref: cut.ref, depth: cut.through ? 'through' : cut.to, size: cut.size, ...(cut.count ? { count: cut.count } : {}) })),
+    }),
+    ...(body && { at: body.at, size: body.size }),
+  };
+}
+const signature = (part: Data, body?: Data) => JSON.stringify(brief({ ...part, ref: undefined }, body));
+
+/** Check result for the model: verdict, diagnostics and only the parts this script added or changed. */
+export function compactCheckReport(checked: unknown, initial: unknown): Data {
+  const report = record(checked),
+    before = record(initial);
+  const bodies = new Map(rows(record(report.assembly).parts).map(body => [body.name, body]));
+  const oldBodies = new Map(rows(record(before.assembly).parts).map(body => [body.name, body]));
+  const oldParts = new Map(rows(before.parts).map(part => [part.name, part]));
+  const parts = rows(report.parts);
+  const changed = parts.filter(part => {
+    const old = oldParts.get(part.name);
+    return !old || signature(old, oldBodies.get(String(old.name))) !== signature(part, bodies.get(String(part.name)));
+  });
+  const names = new Set(parts.map(part => part.name));
+  const all = [...bodies.values()];
+  const size = all.length
+    ? [0, 1, 2].map(axis => {
+        const at = (body: Data) => (body.at as number[])[axis]!,
+          extent = (body: Data) => at(body) + (body.size as number[])[axis]!;
+        return Math.round((Math.max(...all.map(extent)) - Math.min(...all.map(at))) * 100) / 100;
+      })
+    : undefined;
+  return {
+    ok: report.ok,
+    status: report.status,
+    errors: report.errors,
+    warnings: report.warnings,
+    ...(size && { overallSize: size }),
+    changedParts: changed.map(part => brief(part, bodies.get(String(part.name)))),
+    ...(changed.length < parts.length && { unchangedParts: parts.length - changed.length }),
+    ...([...oldParts.keys()].some(name => !names.has(name)) && { removedParts: [...oldParts.keys()].filter(name => !names.has(name)) }),
+    detail: 'Compact result. Use read_design_report (summary, parts, featureList, assembly, steps) or a part name for full data.',
+  };
+}
diff --git a/apps/camNC/src/cad/assistant/structuralWarnings.ts b/apps/camNC/src/cad/assistant/structuralWarnings.ts
new file mode 100644
index 0000000..f5e8f11
--- /dev/null
+++ b/apps/camNC/src/cad/assistant/structuralWarnings.ts
@@ -0,0 +1,40 @@
+import type { CadReport, CadReportIssue } from '@wbcnc/cad-script';
+
+type Body = NonNullable<CadReport['assembly']>['parts'][number];
+const round = (value: number) => Math.round(value);
+const touches = (a: Body, b: Body, tolerance = 0.5) =>
+  [0, 1, 2].every(axis => a.at[axis]! <= b.at[axis]! + b.size[axis]! + tolerance && b.at[axis]! <= a.at[axis]! + a.size[axis]! + tolerance);
+
+/** Rough physical sanity from placed boxes only: a part touching nothing, a tall piece on a small footprint, a thin stick. */
+export function structuralWarnings(report: CadReport): CadReportIssue[] {
+  const bodies = report.assembly?.parts ?? [];
+  if (!bodies.length) return [];
+  const warnings: CadReportIssue[] = [];
+  const low = [0, 1, 2].map(axis => Math.min(...bodies.map(body => body.at[axis]!)));
+  const high = [0, 1, 2].map(axis => Math.max(...bodies.map(body => body.at[axis]! + body.size[axis]!)));
+  if (bodies.length > 1)
+    for (const body of bodies)
+      if (!bodies.some(other => other !== body && touches(body, other)))
+        warnings.push({
+          code: 'floating-part',
+          part: body.name,
+          message: `${body.name} touches no other part, so nothing holds it. Move it onto or into a neighbouring part and join it.`,
+        });
+  const height = high[2]! - low[2]!,
+    footprint = Math.min(high[0]! - low[0]!, high[1]! - low[1]!);
+  if (footprint > 0 && height / footprint > 3)
+    warnings.push({
+      code: 'may-tip',
+      message: `The piece is ${round(height)} mm tall on a ${round(footprint)} mm footprint (${(height / footprint).toFixed(1)}:1). Freestanding, it can tip: widen or deepen the base, or tell the user it must be fixed to a wall.`,
+    });
+  for (const body of bodies) {
+    const across = Math.max(body.size[0]!, body.size[1]!);
+    if (across < 60 && body.size[2]! / across > 20)
+      warnings.push({
+        code: 'slender-part',
+        part: body.name,
+        message: `${body.name} is ${round(body.size[2]!)} mm tall but only ${round(across)} mm across; it may flex or break under load. Thicken it or brace it, or tell the user.`,
+      });
+  }
+  return warnings;
+}
