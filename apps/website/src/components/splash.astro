---
const githubUrl = "https://github.com/plainoss/camNC";
const secondary =
  "inline-flex items-center justify-center rounded-lg border border-white/20 px-5 py-3 text-sm font-semibold text-stone-200 transition hover:border-white/40 hover:bg-white/5 hover:text-white";
---

<section class="bed-grid relative overflow-hidden bg-stone-950 text-stone-100">
  <header class="relative mx-auto flex w-full max-w-6xl items-center justify-between px-6 pt-8">
    <div class="flex items-center gap-3">
      <div class="flex size-10 items-center justify-center overflow-hidden rounded-lg border border-stone-800 bg-stone-900">
        <img src="/favicon.svg" alt="" class="size-full" />
      </div>
      <span class="text-xl font-bold tracking-tight text-white">
        cam<span class="font-extrabold text-amber-500">NC</span>
      </span>
    </div>
    <nav class="flex items-center gap-6 text-sm text-stone-400">
      <a href="#features" class="hidden hover:text-white sm:inline">Features</a>
      <a href="#labs" class="hidden hover:text-white sm:inline">Labs</a>
      <a href="#setup" class="hidden hover:text-white sm:inline">Setup</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white">GitHub</a>
    </nav>
  </header>
  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-6 pb-24 pt-16 lg:grid-cols-[1fr_1.1fr]">
    <div class="flex flex-col gap-6">
      <span class="font-mono text-xs uppercase tracking-[0.25em] text-amber-400">Live machine view · FluidNC</span>
      <h1 class="text-balance text-4xl font-semibold leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl">
        See your toolpath on the real machine bed.
      </h1>
      <p class="max-w-xl text-lg text-stone-300">
        camNC draws the toolpath on a live, corrected camera image of your CNC. Check stock orientation, offsets and clamps
        before the spindle ever turns on.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://run.camnc.app/"
          class="inline-flex items-center justify-center rounded-lg bg-amber-500 px-5 py-3 text-sm font-semibold text-stone-950 transition hover:bg-amber-400 hover:text-stone-950"
        >
          Launch web app
        </a>
        <a href="https://github.com/plainoss/camNC/releases/latest" target="_blank" rel="noopener noreferrer" class={secondary}>
          Download desktop app
        </a>
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class={secondary}>View on GitHub</a>
      </div>
      <p class="max-w-xl border-l-2 border-amber-500/60 pl-4 text-sm text-stone-400">
        New and highly experimental: machine control, CAM for STEP models, simple CAD and AI-generated carvings.
        <a href="#labs" class="text-amber-400 underline-offset-4 hover:underline">See camNC Labs</a>
      </p>
    </div>
    <figure class="overflow-hidden rounded-xl border border-white/10 bg-black shadow-2xl shadow-black/50">
      <img
        src="/hero-top-view.jpg"
        alt="camNC's corrected top view of a machine bed with a toolpath drawn on the stock"
        class="block w-full"
      />
    </figure>
  </div>
</section>
