---
export interface Props {
  id: string;
  title: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="mx-auto flex w-full max-w-6xl scroll-mt-24 flex-col gap-10">
  <div class="flex max-w-3xl flex-col gap-4">
    <slot name="eyebrow" />
    <h2 class="text-4xl font-semibold tracking-tight text-default sm:text-5xl">
      {title}
    </h2>
    <p class="text-xl text-offset">
      <slot name="lead" />
    </p>
  </div>
  <slot />
</section>
