[
  {
    "id": "studio/measure/cylinder-side-selects-whole-face",
    "title": "A click on a cylinder's side selects the whole round face and reads its diameter, its top reads the disc's area, and both read the angle between them",
    "evidence": "design workflow parity spec",
    "steps": [
      "dialogcancel",
      "view top",
      "selectfeature Top",
      "key Shift+s",
      "key g",
      "rect -60,-40 60,40",
      "closesketch",
      "key Shift+e",
      "viewpick -40,-20,0",
      "dialogfill Thickness = 18",
      "key Enter",
      "key Enter",
      "viewpick -40,-20,18",
      "key Shift+s",
      "key c",
      "circle 0,0 18",
      "key d",
      "viewpick 12.728,12.728,0",
      "viewpick 30,30,0",
      "field diameter 36.905",
      "key Escape",
      "closesketch",
      "key Shift+e",
      "viewpick 0,0,18",
      "dialogtab Add",
      "dialogfill Thickness = 25",
      "key Enter",
      "key Enter",
      { "expect": { "studio": { "dialog": null, "workspacePartCount": 1 } } },
      "hideplanes",
      "view iso",
      "checkpoint cylinder",
      { "spec": "1 pick" },
      "viewpick 0,0,110",
      { "expect": { "studio": { "measurements": {} } } },
      { "spec": "2 pick" },
      "viewpick 13.048,-13.048,30",
      { "expect": { "studio": { "measurements": { "Diameter": "36.905 mm" }, "unchangedSince": "cylinder" } } },
      { "spec": "3 pick" },
      "viewpick 0,0,110",
      { "expect": { "studio": { "measurements": {} } } },
      { "spec": "4 pick" },
      "viewpick 0,0,43",
      { "expect": { "studio": { "measurements": { "Area": "1069.695 mm²" } } } },
      { "spec": "5 pick" },
      "viewpick 13.048,-13.048,30",
      { "expect": { "studio": { "measurements": { "Perp axes angle": "90°" } } } },
      { "spec": "6 pick" },
      "viewpick 0,0,110",
      { "expect": { "studio": { "measurements": {}, "unchangedSince": "cylinder" } } }
    ]
  }
]
