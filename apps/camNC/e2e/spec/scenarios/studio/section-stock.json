[
  {
    "id": "studio/section/stock-cap-measurement",
    "title": "A temporary stock section has measurable cut faces, flips, and restores the original material",
    "evidence": "design a 100 by 60 by 18 stock board sectioned at 9 mm; native viewport picks, independent geometry tests and unchanged source",
    "steps": [
      "open ../../../../packages/cad-script/fixtures/designs/measurement-stock.json",
      "closesketch",
      "hideplanes",
      "checkpoint initial",
      "button ^Section view$",
      { "expect": { "studio": { "dialog": "Section view", "section": { "active": true, "editing": true, "plane": "", "offset": "0" } } } },
      "dialogselect Section plane = top",
      "dialogfill Offset = 9",
      "button ^Confirm section view$",
      { "expect": { "studio": { "dialog": null, "section": { "active": true, "editing": false }, "unchangedSince": "initial", "workspacePartCount": 1 } } },
      "view top",
      "pickviewcenter",
      { "expect": { "studio": { "measurements": { "Area": "6000 mm²" } } } },
      "button ^Measure$",
      "view bottom",
      "pickviewcenter",
      { "expect": { "studio": { "measurements": { "Min distance": "9 mm", "Angle": "180°" }, "unchangedSince": "initial" } } },
      "button Close Measure",
      "button ^Edit section view$",
      { "expect": { "studio": { "section": { "plane": "top", "offset": "9", "flipped": false } } } },
      "button ^Flip plane$",
      "button ^Confirm section view$",
      "view bottom",
      "pickviewcenter",
      { "expect": { "studio": { "measurements": { "Area": "6000 mm²" }, "section": { "active": true, "editing": false } } } },
      "button ^Turn off section view$",
      "view top",
      "pickviewcenter",
      "button ^Measure$",
      "view bottom",
      "pickviewcenter",
      { "expect": { "studio": { "measurements": { "Min distance": "18 mm" }, "section": { "active": false }, "unchangedSince": "initial", "sameIdsSince": "initial" } } },
      "button Close Measure",
      "key Shift+X",
      { "expect": { "studio": { "section": { "active": true, "editing": true, "plane": "top", "offset": "9", "flipped": true }, "unchangedSince": "initial" } } },
      "key Escape",
      "reload",
      { "expect": { "studio": { "section": { "active": false }, "unchangedSince": "initial", "sameIdsSince": "initial", "workspacePartCount": 1 } } }
    ]
  }
]
