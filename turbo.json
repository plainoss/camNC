{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc"],
  // The Mergify test reporters read their key, job name and the run they belong to from these. Not hashed: a replayed
  // task uploads nothing, and the key or run never changes what a test does.
  "globalPassThroughEnv": ["MERGIFY_*", "GITHUB_*", "RUNNER_*"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "VITE_CLERK_PUBLISHABLE_KEY"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    // Not a script: lets a package's test hash include its workspace dependencies' files (camNC's tests run
    // @wbcnc/cam's code), without running their tests first. See turbo's "transit nodes".
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/test-timings.mjs", "$TURBO_ROOT$/scripts/balanced-shards.mjs"],
      // JUnit reports are uploaded as the run's results, so a replay must not restore them.
      "outputs": ["test-results/**", "!test-results/junit/**"],
      "env": ["CI", "FLUIDNC_SIM_HOST", "FLUIDNC_SIM_VARIANT"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "CAM_OUT_DIR"]
    },
    // Its own task, so a run without the slowest files can never replay as a passed "test".
    "test:fast": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/balanced-shards.mjs", "$TURBO_ROOT$/scripts/test-timings.mjs"],
      "dependsOn": ["^transit"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:domain": {
      "dependsOn": [
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-timings.mjs", "$TURBO_ROOT$/scripts/balanced-shards.mjs"
      ],
      "outputs": [
        "test-results/domain.json"
      ],
      "env": [
        "CI"
      ]
    },
    "test:worker": {
      "dependsOn": [
        "^transit"
      ],
      "outputs": [
        "test-results/worker.json"
      ],
      "env": [
        "CI"
      ]
    },
    "test:licenses": {
      "dependsOn": [
        "^transit"
      ],
      "env": [
        "CI"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-timings.mjs", "$TURBO_ROOT$/scripts/balanced-shards.mjs", "$TURBO_ROOT$/scripts/quarantine.mjs"
      ],
      "outputs": [
        "test-results/browser*.json"
      ],
      // Hashed, so a batch shard that passed only on a retry (VITEST_RETRY=1) or by skipping quarantined tests
      // (VITEST_QUARANTINE) never replays as a pass for a run that retries and skips nothing, such as a `full-ci` PR.
      "env": [
        "CI",
        "VITEST_RETRY",
        "VITEST_QUARANTINE"
      ],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "spec:cad": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/balanced-shards.mjs", "$TURBO_ROOT$/scripts/test-timings.mjs"],
      "dependsOn": [
        "^transit"
      ],
      "outputs": [
        "test-results/spec/**"
      ],
      "env": [
        "CI",
        "VITE_CLERK_PUBLISHABLE_KEY"
      ],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "smoke:setup": {
      "cache": false,
      "env": ["CAMNC_SMOKE_URL", "CAMNC_SMOKE_HEADED", "CAMNC_SMOKE_OUTPUT"]
    },
    // Lint rules live in the root .oxlintrc.json, which no package task sees otherwise.
    "lint": { "dependsOn": ["^transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"] },
    "check-types": { "dependsOn": ["^transit"] },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "CAMNC_SKIP_TYPECHECK",
        "VITE_CLERK_PUBLISHABLE_KEY"
      ]
    }
  }
}
